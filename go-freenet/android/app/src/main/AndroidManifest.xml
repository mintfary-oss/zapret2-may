<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for VpnService (TUN interface, no root needed). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Android 13+ (API 33) requires this runtime permission to show the
        foreground-service notification that displays VPN connection status.
        On older versions the permission is granted automatically at install.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeNet">

        <!-- Main activity — the single-screen ON/OFF UI. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FreenetVpnService — manages the TUN interface.
            android:permission ensures only the system can bind to it.
            The foregroundServiceType is required on Android 14+.
        -->
        <service
            android:name=".FreenetVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Boot receiver — auto-start VPN after device reboot (optional). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          FreeNetWidget — 2×1 home screen toggle button.
          android:exported="true" is required so the launcher can send
          APPWIDGET_UPDATE intents to this receiver.
        -->
        <receiver
            android:name=".FreeNetWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.freenet.vpn.WIDGET_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/freenet_widget_info" />
        </receiver>

    </application>

    <!--
        Android 11+ (API 30) package-visibility rules: without explicit <queries>
        declarations, PackageManager.getPackageInfo() throws NameNotFoundException
        for every app that isn't in the list below, so the DNS-setup browser
        detection card would always show "no browsers found".
        https://developer.android.com/training/package-visibility
    -->
    <queries>
        <!-- Google Chrome family -->
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.chrome.canary" />
        <!-- Yandex Browser -->
        <package android:name="com.yandex.browser" />
        <package android:name="com.yandex.browser.beta" />
        <package android:name="com.yandex.browser.lite" />
        <!-- Mozilla Firefox -->
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fenix" />
        <!-- Brave -->
        <package android:name="com.brave.browser" />
        <package android:name="com.brave.browser_beta" />
        <package android:name="com.brave.browser_nightly" />
        <!-- Microsoft Edge -->
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.microsoft.emmx.beta" />
        <!-- Opera -->
        <package android:name="com.opera.browser" />
        <package android:name="com.opera.browser.beta" />
        <package android:name="com.opera.gx_mobile" />
        <package android:name="com.opera.mini.native" />
        <!-- Samsung Internet -->
        <package android:name="com.sec.android.app.sbrowser" />
        <!-- Kiwi -->
        <package android:name="com.kiwibrowser.browser" />
        <!-- DuckDuckGo -->
        <package android:name="com.duckduckgo.mobile.android" />
        <!-- OEM browsers -->
        <package android:name="com.mi.globalbrowser" />
        <package android:name="com.huawei.browser" />
        <package android:name="com.vivo.browser" />
        <package android:name="com.heytap.browser" />
        <!-- Other -->
        <package android:name="com.naver.whale.android" />
        <package android:name="com.UCMobile.intl" />
        <package android:name="mark.via.gp" />
    </queries>

</manifest>
